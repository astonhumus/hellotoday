VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=your-publishable-key
# VITE_ADMIN_ROUTE=optional-extra-sign-in-address   (sign in always works at #/admin)
# Optional
VITE_CONTACT_EMAIL=you@example.com          # shown on the About page for copyright / takedown requests
VITE_TURNSTILE_SITE_KEY=                    # Cloudflare Turnstile site key; also enable CAPTCHA in Supabase > Authentication
VITE_TILE_URL=                              # another map tile provider; add its host to img-src in public/_headers
VITE_SITE_URL=                              # the public address, e.g. https://your-domain.com (used for canonical links, sitemap, share previews)
VITE_GSC_VERIFICATION=                      # Google Search Console verification code (HTML tag method)
