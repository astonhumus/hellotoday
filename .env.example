VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_KEY=your-publishable-key
# VITE_ADMIN_ROUTE=optional-extra-sign-in-address   (sign in always works at #/admin)
# Optional
VITE_CONTACT_EMAIL=you@example.com          # shown on the About page for copyright / takedown requests
VITE_TURNSTILE_SITE_KEY=                    # Cloudflare Turnstile site key; also enable CAPTCHA in Supabase > Authentication
VITE_MAP_STYLE=                             # another MapLibre street-map style (default: OpenFreeMap liberty); add its hosts to connect-src and img-src in public/_headers
VITE_MAP_STYLE_DARK=                        # the same for the dark theme (default: OpenFreeMap dark)
VITE_ROUTING_URL=                           # your own OSRM server for road distances (default: public OSRM demo); add its host to connect-src
VITE_GEOCODER_URL=                          # your own Nominatim server for addresses (default: nominatim.openstreetmap.org); add its host to connect-src
VITE_SITE_URL=                              # the public address, e.g. https://your-domain.com (used for canonical links, sitemap, share previews)
VITE_GSC_VERIFICATION=                      # Google Search Console verification code (HTML tag method)
